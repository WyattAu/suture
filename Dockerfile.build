FROM rust:1.85-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends protobuf-compiler pkg-config libssl-dev tini && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
RUN for d in crates/*/; do mkdir -p "$d/src" && echo "" > "$d/src/lib.rs"; done
RUN cargo build --release -p suture-platform 2>/dev/null || true
COPY . .
RUN touch crates/suture-platform/src/**/*.rs crates/suture-platform/src/*.rs
RUN cargo build --release -p suture-platform
RUN groupadd -r suture && useradd -r -g suture -d /data suture
FROM gcr.io/distroless/cc-debian12
COPY --from=builder /app/target/release/suture-platform /suture-platform
COPY --from=builder /etc/passwd /etc/passwd
COPY --from=builder /etc/group /etc/group
COPY --from=builder /usr/bin/tini /usr/bin/tini
RUN mkdir -p /data && chown suture:suture /data
USER suture
WORKDIR /data
ENTRYPOINT ["/usr/bin/tini", "--"]
