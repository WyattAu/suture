#!/usr/bin/env bash
# === suture pre-commit quality gate ===
# Runs fmt, clippy, and targeted tests before allowing a commit.
# Install: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or:     just install-hooks
#
# Bypass (emergency only): SUTURE_SKIP_CHECKS=1 git commit ...

set -euo pipefail

if [ "${SUTURE_SKIP_CHECKS:-0}" = "1" ]; then
    printf "SUTURE_SKIP_CHECKS=1 -- bypassing pre-commit checks\n"
    exit 0
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Crates excluded from checks (not part of core workspace builds, or require special setup)
EXCLUDE="--exclude suture-fuzz --exclude suture-py --exclude suture-node --exclude suture-e2e --exclude suture-bench --exclude suture-vfs --exclude suture-lsp --exclude suture-daemon --exclude suture-wasm-plugin"

pass()  { echo -e "${GREEN}PASS${NC}"; }
fail()  { echo -e "${RED}FAIL${NC}"; }

header() {
    echo ""
    echo -e "${BLUE}=== suture pre-commit quality gates ==="
    echo -e "    $(date -u +'%Y-%m-%dT%H:%M:%SZ')${NC}"
    echo ""
}

header

GATE_FAIL=0

# --- Gate 1: cargo fmt (all crates, fast) ---
echo -n "[1/3] cargo fmt --check ... "
if cargo fmt --all -- --check > /tmp/suture-precommit-fmt.log 2>&1; then
    pass
else
    fail
    echo -e "  ${YELLOW}Formatting issues found. Run 'cargo fmt --all' to fix.${NC}"
    cat /tmp/suture-precommit-fmt.log | head -20
    GATE_FAIL=1
fi

# --- Gate 2: cargo clippy (strict, workspace minus excluded) ---
echo -n "[2/3] cargo clippy ${EXCLUDE} -- -D warnings ... "
if cargo clippy --workspace ${EXCLUDE} -- -D warnings > /tmp/suture-precommit-clippy.log 2>&1; then
    pass
else
    fail
    echo -e "  ${YELLOW}Clippy found issues:${NC}"
    grep -E '^(error|warning)\[' /tmp/suture-precommit-clippy.log | head -20
    GATE_FAIL=1
fi

# --- Gate 3: cargo test (workspace minus excluded, serial for CWD-dependent tests) ---
echo "[3/3] cargo test --workspace ${EXCLUDE} -- --test-threads=1 ..."
if cargo test --workspace ${EXCLUDE} -- --test-threads=1 > /tmp/suture-precommit-test.log 2>&1; then
    echo -e "  ${GREEN}All tests passed.${NC}"
else
    echo -e "  ${RED}Test failures detected.${NC}"
    grep -E '^(test |failures:|test result:)' /tmp/suture-precommit-test.log | tail -20
    GATE_FAIL=1
fi

echo ""
if [ "$GATE_FAIL" -ne 0 ]; then
    echo -e "${RED}Pre-commit checks FAILED. Commit aborted.${NC}"
    echo -e "${YELLOW}Fix issues above, then re-commit.${NC}"
    echo -e "${YELLOW}Emergency bypass: SUTURE_SKIP_CHECKS=1 git commit ...${NC}"
    exit 1
fi

echo -e "${GREEN}All quality gates passed. Proceeding with commit.${NC}"
echo ""
